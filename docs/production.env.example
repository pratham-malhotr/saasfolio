# Set these in local .env.local and in the hosting environment. Never commit real keys.
NEXT_PUBLIC_SITE_URL=https://saasfolio.tech
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Or use NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY with a current project.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_EMAILS=owner@example.com
RATE_LIMIT_SECRET=generate-a-long-random-secret
AUTH_RECOVERY_SECRET=replace-with-64-random-hexadecimal-characters
# Google and Apple client secrets belong in the Supabase Auth provider dashboard.
# Configure exact callback URLs; see docs/AUTHENTICATION.md.
# Never enable LOCAL_AUTH_ENABLED in production.
# Optional. Set only when the trusted edge overwrites this header and the origin
# cannot be reached directly. Vercel auto-selects x-vercel-forwarded-for.
# TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip
RESEND_API_KEY=re_your_api_key_here
NEWSLETTER_FROM_EMAIL=SaaSFolio <newsletter@saasfolio.tech>
