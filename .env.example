# SaaSFolio Environment Configuration
NEXT_PUBLIC_SITE_URL=https://saasfolio.tech
NEXT_PUBLIC_APP_ENV=development

# Database (Supabase / Postgres / SQLite)
DATABASE_URL="file:./dev.db"
DIRECT_URL="file:./dev.db"

# Production account authentication (Google, Apple and email/password)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Current Supabase projects may use NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY instead.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Required persistent request-limit function: apply the Supabase migration.
# Configure Google and Apple credentials in Supabase Auth, never NEXT_PUBLIC_*.
RATE_LIMIT_SECRET=replace-with-a-long-random-secret
AUTH_RECOVERY_SECRET=replace-with-64-random-hexadecimal-characters

# Optional development-only accounts; disabled by default and always in production.
# LOCAL_AUTH_ENABLED=true
# LOCAL_AUTH_SECRET=<64 hexadecimal characters generated with openssl rand -hex 32>
# LOCAL_AUTH_DATA_DIR=/absolute/private/development-data-directory

# Resend Email Configuration (Newsletter & Alerts)
RESEND_API_KEY=re_your_api_key_here
NEWSLETTER_FROM_EMAIL=newsletter@saasfolio.tech

# Analytics (Plausible / GA)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=saasfolio.tech
