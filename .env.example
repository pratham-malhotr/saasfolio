# SaaSFolio Environment Configuration
NEXT_PUBLIC_SITE_URL=https://saasfolio.tech
NEXT_PUBLIC_APP_ENV=development

# Production account authentication (Google, Apple and email/password)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Current Supabase projects may use NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY instead.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Required persistent request-limit function: apply the Supabase migration.
# Configure Google and Apple credentials in Supabase Auth, never NEXT_PUBLIC_*.
RATE_LIMIT_SECRET=replace-with-a-long-random-secret
AUTH_RECOVERY_SECRET=replace-with-64-random-hexadecimal-characters
# First confirmed owner only; later staff assignments use /admin with MFA.
ADMIN_EMAILS=owner@example.com
# Set only after confirming which single header the hosting ingress overwrites.
# TRUSTED_CLIENT_IP_HEADER=x-forwarded-for

# Optional development-only accounts; disabled by default and always in production.
# LOCAL_AUTH_ENABLED=true
# LOCAL_AUTH_SECRET=<64 hexadecimal characters generated with openssl rand -hex 32>
# LOCAL_AUTH_DATA_DIR=/absolute/private/development-data-directory

# Resend Email Configuration (Newsletter & Alerts)
RESEND_API_KEY=re_your_api_key_here
NEWSLETTER_FROM_EMAIL=newsletter@saasfolio.tech
RESEND_WEBHOOK_SECRET=whsec_replace-with-the-endpoint-signing-secret

# Optional analytics loads only after visitor consent.
NEXT_PUBLIC_GA_ID=G-7G7TJJENC0
# Client diagnostics sends only allowlisted error identifiers and route templates.
NEXT_PUBLIC_CLIENT_DIAGNOSTICS=false
# Protected operational status; generate a random token of at least 32 characters.
MONITORING_TOKEN=replace-with-a-long-random-monitoring-secret
APP_RELEASE=development

# Offline operational tools. Keep real values in the secret manager.
# BACKUP_DATABASE_URL=postgresql://backup-user:password@db.project.supabase.co/postgres?sslmode=verify-full
# BACKUP_ENCRYPTION_KEY=<64 random hexadecimal characters; retain separately>
# BACKUP_DIRECTORY=/private/encrypted-export-directory
# RESTORE_TEST_URL=postgresql://postgres:password@127.0.0.1/postgres?sslmode=disable
# Retention is unset by default; review policy before explicitly configuring days.
# INQUIRY_RETENTION_DAYS=365
# PENDING_NEWSLETTER_RETENTION_DAYS=30
# UNSUBSCRIBED_RETENTION_DAYS=90
